# Spreadsheet ID from its Google Sheets URL. The current project's ID is configured in .env.local.
GOOGLE_SHEETS_SPREADSHEET_ID=
# For a publicly readable sheet, an API key (kept server-side) is sufficient:
GOOGLE_SHEETS_API_KEY=
# For a private sheet, provide a service account email and private key instead:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
