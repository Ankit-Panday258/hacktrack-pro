# Optional: enables broad listings from Brabble.ai. Keep the key server-side.
# Generate a free key in Brabble Developer settings; the API requires authentication.
BRABBLE_API_KEY=

# Cloud tracker database URL. Vercel injects this when the free Neon Postgres
# Marketplace resource is connected to the project. Never expose it to the browser.
DATABASE_URL=

# Google identity sign-in and optional Gmail import use the existing OAuth Web client.
# Register both redirect URIs in Google Cloud; Gmail import also needs the gmail.readonly scope.
# https://hacktrack-pro.vercel.app/api/auth/callback/google
# https://hacktrack-pro.vercel.app/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a long random server-only secret and store it in Vercel Production.
BETTER_AUTH_SECRET=

# Production only. Leave unset in local development so the request origin is used.
BETTER_AUTH_URL=
